{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "sudokugame",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "preview/index.html",
        "height": "tall",
        "inline": true
      },
      "game": {
        "entry": "game/index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "media": true,
    "realtime": true,
    "reddit": {
      "scope": "moderator",
      "asUser": [
        "SUBMIT_COMMENT",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "Sudoku",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install",
    "onPostCreate": "/internal/on-post-create"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/cron/daily-post",
        "cron": "0 * * * *"
      },
      "weekly-roundup": {
        "endpoint": "/internal/cron/weekly-roundup",
        "cron": "0 * * * *"
      }
    }
  },
  "settings": {
    "subreddit": {
      "featuredDifficulty": {
        "type": "select",
        "label": "Featured race difficulty",
        "helpText": "Choose which difficulty powers the public daily race.",
        "defaultValue": "intermediate",
        "options": [
          {
            "label": "Simple",
            "value": "simple"
          },
          {
            "label": "Easy",
            "value": "easy"
          },
          {
            "label": "Intermediate",
            "value": "intermediate"
          },
          {
            "label": "Expert",
            "value": "expert"
          }
        ]
      },
      "dailyPostHourUtc": {
        "type": "number",
        "label": "Daily post hour (UTC)",
        "helpText": "The scheduler checks hourly and creates the daily post when the current UTC hour matches this value.",
        "defaultValue": 8
      },
      "weeklyRoundupDay": {
        "type": "select",
        "label": "Weekly roundup day",
        "helpText": "Choose the weekday for the automated weekly roundup post.",
        "defaultValue": "mon",
        "options": [
          {
            "label": "Sunday",
            "value": "sun"
          },
          {
            "label": "Monday",
            "value": "mon"
          },
          {
            "label": "Tuesday",
            "value": "tue"
          },
          {
            "label": "Wednesday",
            "value": "wed"
          },
          {
            "label": "Thursday",
            "value": "thu"
          },
          {
            "label": "Friday",
            "value": "fri"
          },
          {
            "label": "Saturday",
            "value": "sat"
          }
        ]
      },
      "winnerFlairEnabled": {
        "type": "boolean",
        "label": "Enable weekly winner flair",
        "helpText": "Turn this on only in communities where replacing user flair is acceptable.",
        "defaultValue": false
      }
    }
  },
  "dev": {
    "subreddit": "cat543"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
